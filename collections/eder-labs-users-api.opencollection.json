{
  "opencollection": "1.0.0",
  "info": {
    "name": "Persona Ingestion Users API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:8000/api/v1/users/:user_id",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the user. Pattern ^[a-zA-Z0-9_-]+$."
              }
            ]
          },
          "docs": "Creates a new user (memory namespace). Returns 201 when newly created, 200 when the user already exists. User IDs must match ^[a-zA-Z0-9_-]+$."
        },
        {
          "info": {
            "name": "Delete a user",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "http://localhost:8000/api/v1/users/:user_id",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier for the user. Pattern ^[a-zA-Z0-9_-]+$."
              }
            ]
          },
          "docs": "Deletes an existing user and their memory namespace."
        }
      ]
    }
  ],
  "bundled": true
}